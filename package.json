{
  "name": "pool-spa-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_DATA_MODE=mock next dev",
    "dev:local:bypass": "NEXT_PUBLIC_DATA_MODE=mock NEXT_PUBLIC_DEV_AUTH_BYPASS=true next dev",
    "dev:auth": "NEXT_PUBLIC_DATA_MODE=amplify NEXT_PUBLIC_DEV_AUTH_BYPASS=false next dev",
    "dev:amplify": "NEXT_PUBLIC_DATA_MODE=amplify next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "localstack:up": "docker compose up -d localstack",
    "localstack:down": "docker compose down",
    "localstack:logs": "docker compose logs -f localstack",
    "health:check": "curl -sf http://localhost:3000/api/health | python3 -m json.tool",
    "sandbox": "ampx sandbox"
  },
