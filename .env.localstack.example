# LocalStack is optional and NOT wired into the app data layer yet.
# Setting NEXT_PUBLIC_DATA_MODE=localstack currently falls back to in-memory mock.
#
# For DynamoDB-backed local testing, use Amplify sandbox instead:
#   pnpm sandbox
#   pnpm dev:auth
#
# These variables are reserved for a future LocalStackDataProvider.
NEXT_PUBLIC_DATA_MODE=localstack

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

AWS_ENDPOINT_URL=http://localhost:4566
NEXT_PUBLIC_AWS_ENDPOINT_URL=http://localhost:4566
