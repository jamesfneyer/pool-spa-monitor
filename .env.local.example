# Data mode: mock | amplify | localstack
#
# --- Local development only ---
# Copy this file to .env.local for file-based config on your machine.
# Hosted Amplify branches (main, staging, pr-*) set these in the
# Amplify Console under Hosting → Environment variables instead.
#
# Recommended local workflow:
#   mock     — pnpm dev:local        (fast UI work, in-memory seed data)
#   amplify  — pnpm sandbox + pnpm dev:auth  (real DynamoDB via Amplify sandbox)
#
# localstack is scaffolded but not implemented; it falls back to mock storage.
NEXT_PUBLIC_DATA_MODE=mock

# Skip auth only in mock mode for faster UI development (opt-in)
# Or use: pnpm dev:local:bypass
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# App URL (used for redirects)
# Local: http://localhost:3000
# Hosted: set per branch in Amplify Console (e.g. https://main.<app-id>.amplifyapp.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth email sender (Amplify backend / sandbox deploy only) ---
# Local sandbox: export before `pnpm sandbox`, or set in Amplify Console → Secrets for hosted branches.
# Leave unset for dev: Cognito uses its default sender.
# Set when you have a verified SES identity. See docs/email-setup.md
# AUTH_EMAIL_FROM=noreply@yourdomain.com
# AUTH_EMAIL_FROM_NAME=Pool & Spa Command Center
# AUTH_EMAIL_REPLY_TO=support@yourdomain.com
