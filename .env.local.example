# Data mode: mock | amplify | localstack
#
# Recommended local workflow:
#   mock     — pnpm dev:local        (fast UI work, in-memory seed data)
#   amplify  — pnpm sandbox + pnpm dev:auth  (real DynamoDB via Amplify sandbox)
#
# localstack is scaffolded but not implemented; it falls back to mock storage.
NEXT_PUBLIC_DATA_MODE=mock

# Skip auth only in mock mode for faster UI development (opt-in)
# Or use: pnpm dev:local:bypass
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# App URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
